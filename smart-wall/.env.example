# Example only. Development loads .env.local; production uses service environment.
MONGODB_URI=mongodb://127.0.0.1:27019/?replicaSet=smartwall
MONGODB_DATABASE=smartwall
APP_ORIGIN=http://127.0.0.1:4200
HOST=127.0.0.1
PORT=3001
DATA_DIRECTORY=.data
BACKUP_DIR=.backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN=7
# Production requires HTTPS APP_ORIGIN, authenticated TLS MongoDB and stable secrets:
# NODE_ENV=production
# JWT_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# MAIL_MODE=resend
# RESEND_API_KEY=SET_IN_SECRET_MANAGER
# MAIL_FROM=SmartWall <hello@YOUR_VERIFIED_DOMAIN>
# MAIL_ENCRYPTION_KEY=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Gmail alternative (use mail:setup:gmail; never commit the app password):
# MAIL_MODE=gmail
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=SET_LOCALLY_ONLY

# Optional extra, disabled for the internship build:
ENABLE_EMAIL_FEATURES=false

# Render detects its HTTPS URL from RENDER_EXTERNAL_URL when APP_ORIGIN is unset.
# Configure the hop count only for the actual trusted hosting proxy.
# TRUST_PROXY_HOPS=1
# PASSWORD_HASH_CONCURRENCY=1
# LOCAL_BACKUPS_ENABLED=false # Only when durable backups are handled off-host
